# ============================================================
# DataSphere - Variables d'environnement (PRODUCTION)
# Copier en .env et remplir avec vos vraies credentials
# ============================================================

# --- App ---
NODE_ENV=production
PORT=10000
HOSTNAME=0.0.0.0

# URL publique de l'app (Render la fournit automatiquement)
NEXT_PUBLIC_APP_URL=http://localhost:10000

# --- Base de données PostgreSQL ---
# En local : installer PostgreSQL ou utiliser Docker :
#   docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=pass -e POSTGRES_DB=datasphere postgres:16
DATABASE_URL="postgresql://postgres:pass@localhost:5432/datasphere?schema=public"

# --- Auth ---
# Générer avec : openssl rand -hex 32
DATASPHERE_AUTH_SECRET=change-me-please-use-32-chars-min

# --- LinkedIn OAuth (https://www.linkedin.com/developers/apps) ---
# Créer une app, ajouter les produits "Sign In with LinkedIn" + "Share on LinkedIn"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# URL exacte configurée dans LinkedIn Developer app
LINKEDIN_REDIRECT_URI=http://localhost:10000/api/linkedin/callback

# --- Stripe (https://dashboard.stripe.com) ---
# Clés sk_test_* (test) ou sk_live_* (prod)
STRIPE_SECRET_KEY=
# Webhook secret (à créer dans Stripe > Developers > Webhooks)
STRIPE_WEBHOOK_SECRET=
# Price IDs des abonnements (à créer dans Stripe > Products)
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_BUSINESS_MONTHLY=

# --- Cron (Render) ---
# Secret partagé pour protéger /api/cron/* endpoints
# Render l'auto-génère si vous utilisez le render.yaml
CRON_SECRET=

# --- Email (Resend, https://resend.com) ---
# Optionnel : si non défini, les emails sont loggés en console
RESEND_API_KEY=
FROM_EMAIL=DataSphere <noreply@datasphere.app>

# --- Sentry (monitoring, https://sentry.io) ---
# Optionnel : si non défini, Sentry est no-op (safe en dev)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optionnel : pour uploader les source maps
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Logs ---
LOG_LEVEL=info  # debug | info | warn | error
