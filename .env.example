# ============================================================
# DataSphere - Variables d'environnement
# Copier en .env et remplir
# ============================================================

# --- App ---
NODE_ENV=production
PORT=10000
HOSTNAME=0.0.0.0

# --- Base de données ---
# SQLite (dev local) :
DATABASE_URL="file:./dev.sqlite"
# PostgreSQL (production Render) - laisser vide en dev, Render l'injecte :
# DATABASE_URL="postgresql://user:pass@host:5432/datasphere?schema=public"

# --- Auth ---
# Générer avec : openssl rand -hex 32
DATASPHERE_AUTH_SECRET=change-me-please

# --- LinkedIn OAuth ---
# https://www.linkedin.com/developers/apps
# Laisser vide en démo (DEMO_MODE=true simule la publication)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:10000/api/linkedin/callback

# --- Démo ---
# Si "true", la publication LinkedIn est simulée (pas d'appel API réel)
# ⚠️ Mettre à "false" en production commerciale réelle
DEMO_MODE=false
