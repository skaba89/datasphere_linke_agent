generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model SmartPosterSettings {
  id                String   @id @default(cuid())
  maxPostsPerDay    Int      @default(3)
  enabled           Boolean  @default(true)
  scheduleHourStart Int      @default(7)
  scheduleHourEnd   Int      @default(8)
  timezone          String   @default("Europe/Paris")
  autoApprove       Boolean  @default(false)
  topics            String   @default("IA, tech, marketing digital, entrepreneurship")
  tone              String   @default("professionnel mais accessible")
  language          String   @default("fr")
  targetAudience    String   @default("entrepreneurs, CTO, managers tech")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model PostProposal {
  id             String   @id @default(cuid())
  title          String
  content        String
  hashtags       String
  format         String
  angle          String
  targetAudience String
  qualityScore   Float
  optimalTime    String
  status         String   @default("pending")
  engagementEst  String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EngagementMetric {
  id        String   @id @default(cuid())
  date      String
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}