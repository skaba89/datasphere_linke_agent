generator client {
  provider = "prisma-client-js"
}

// ============================================================
// DataSphere - Schéma Prisma (PostgreSQL production)
//
// Provider : postgresql (production Render)
// Pour le dev local, vous pouvez installer PostgreSQL ou utiliser
// Docker : docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=pass postgres:16
// ============================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & USERS
// ============================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          String    @default("user") // user | admin
  plan          String    @default("free") // free | pro | business
  trialEndsAt   DateTime?

  // Stripe billing
  stripeCustomerId           String?
  stripeSubscriptionId       String?
  stripeSubscriptionStatus   String?

  // Pour invitations team : email de l'invité (peut être null si user créé directement)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  linkedinAccounts LinkedInAccount[]
  posts         PostProposal[]  @relation("UserPosts")
  settings      SmartPosterSettings?

  // Multi-utilisateurs (Teams)
  teamMemberships  TeamMember[]
  teamInvitations  TeamInvitation[] @relation("InvitedUser")
  sentInvitations  TeamInvitation[] @relation("InvitedBy")
  ownedTeams       Team[]           @relation("TeamOwner")
  assignedByAssignments ClientAssignment[] @relation("AssignedBy")

  // API publique (Plan Business)
  apiKeys          ApiKey[]

  // Revenue Attribution
  revenueAttributions RevenueAttribution[] @relation("UserRevenue")

  // AI Agent Workspace
  agentTasks  AgentTask[]  @relation("UserAgentTasks")
  agentMemory AgentMemory[] @relation("UserAgentMemory")

  // Audit Log (actions effectuées par cet user, typiquement admin)
  auditLogs   AuditLog[]   @relation("UserAuditLogs")

  // Affiliation
  referralCode    String?    @unique // code personnalisé (ex: "marie2026")
  referredById    String?    // user qui a référé ce user
  referrals       Referral[] @relation("Referrer")
  referredBy      Referral[] @relation("Referred")
  payouts         Payout[]

  // 2FA / TOTP
  twoFactorSecret       String?   // secret TOTP chiffré
  twoFactorEnabled      Boolean   @default(false)
  twoFactorBackupCodes  String?   // codes de secours hashés (JSON)

  // Notifications in-app
  notifications         Notification[]

  // Agency clients (LinkedIn accounts managed by this user)
  clients              Client[]

  // CRM & Prospecting
  prospects            Prospect[]
  crmSequences         CrmSequence[]
  crmMessages          CrmMessage[]

  // Automation
  commentReplies       CommentReply[]
  automationLogs       AutomationLog[]

  @@index([email])
  @@index([plan])
  @@index([referralCode])
  @@index([referredById])
}

// ============================================================
// CLIENTS - Agency managed LinkedIn accounts
// ============================================================

model Client {
  id              String   @id @default(cuid())
  userId          String   // agency owner
  name            String   // ex: "Team DataSphere"
  linkedinAccountId String? // linked LinkedInAccount (nullable)
  monthlyGoal     Int      @default(20) // posts per month target
  active          Boolean  @default(true)
  color           String   @default("#10b981") // for UI
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts           PostProposal[] @relation("ClientPosts")
  assignments     ClientAssignment[]
  revenueAttributions RevenueAttribution[] @relation("ClientRevenue")

  @@index([userId])
  @@index([active])
}

// ============================================================
// PROSPECTS & CRM - Réseau & Prospection
// ============================================================

model Prospect {
  id          String   @id @default(cuid())
  userId      String
  name        String
  linkedinUrl String?
  email       String?
  company     String?
  title       String?   // job title
  stage       String   @default("new") // new | contacted | replied | meeting | won | lost
  notes       String?
  tags        String?  // comma-separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    CrmMessage[]
  revenueAttributions RevenueAttribution[] @relation("ProspectRevenue")

  @@index([userId])
  @@index([stage])
  @@index([company])
}

model CrmSequence {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  steps       Json     // [{day:1, subject:"Hello", body:"..."}, ...]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages    CrmMessage[]

  @@index([userId])
  @@index([active])
}

model CrmMessage {
  id          String   @id @default(cuid())
  userId      String
  prospectId  String
  sequenceId  String?
  stepIndex   Int?
  subject     String
  body        String
  status      String   @default("draft") // draft | sent | replied | bounced
  sentAt      DateTime?
  repliedAt   DateTime?
  createdAt   DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  prospect    Prospect     @relation(fields: [prospectId], references: [id], onDelete: Cascade)
  sequence    CrmSequence? @relation(fields: [sequenceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([prospectId])
  @@index([status])
}

// ============================================================
// AUTOMATION - Auto-reply commentaires + Email bridge
// ============================================================

model CommentReply {
  id            String   @id @default(cuid())
  userId        String
  postProposalId String?  // post concerné (si dans notre DB)
  linkedinPostId String?  // URN du post LinkedIn
  commenterName String
  commenterText String
  generatedReply String  // réponse générée par l'IA
  status        String   @default("pending") // pending | approved | sent | rejected | edited
  editedReply   String?  // si l'utilisateur a modifié la réponse
  sentiment     String?  // positive | neutral | negative (analyse IA)
  createdAt     DateTime @default(now())
  repliedAt     DateTime?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AutomationLog {
  id          String   @id @default(cuid())
  userId      String
  type        String   // sequence_email | comment_reply | message_bridge
  action      String   // sent | generated | failed | skipped
  details     String?  // JSON avec contexte
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============================================================
// NOTIFICATIONS - In-app notification system
// ============================================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // info | success | warning | error | billing | team | linkedin
  title     String
  message   String
  link      String?  // URL optionnelle pour rediriger au clic
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
}

// ============================================================
// API KEYS - Accès programmatique (Plan Business)
// ============================================================

model ApiKey {
  id          String    @id @default(cuid())
  userId      String
  name        String    // label donné par l'utilisateur
  keyPrefix   String    // 8 premiers caractères (pour affichage)
  hashedKey   String    @unique // hash bcrypt de la clé complète
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hashedKey])
}

// ============================================================
// AFFILIATION - Programme de parrainage
// ============================================================

model Referral {
  id            String   @id @default(cuid())
  referrerId    String   // user qui a partagé son code
  referredId    String   // user qui s'est inscrit via le code
  referralCode  String   // code utilisé (snapshot)
  status        String   @default("pending") // pending | converted | paid
  commissionAmount Int   @default(0) // en centimes (20% du MRR)
  convertedAt   DateTime? // set quand le referred passe en payant
  paidAt        DateTime? // set quand le payout est effectué
  payoutId      String?  // lien vers le payout
  createdAt     DateTime @default(now())

  referrer      User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referred      User     @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  payout        Payout?  @relation(fields: [payoutId], references: [id])

  @@unique([referredId]) // un user ne peut être référé qu'une fois
  @@index([referrerId])
  @@index([status])
  @@index([referralCode])
}

model Payout {
  id            String    @id @default(cuid())
  userId        String    // user qui reçoit le paiement
  amount        Int       // en centimes
  currency      String    @default("EUR")
  status        String    @default("pending") // pending | paid | failed
  period        String    // ex: "2026-10" (YYYY-MM)
  paidAt        DateTime?
  stripeTransferId String? // ID du transfert Stripe Connect
  referrals     Referral[]
  createdAt     DateTime  @default(now())

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period])
  @@index([userId])
  @@index([status])
}

// ============================================================
// TEAMS (Multi-utilisateurs - plan Business)
// ============================================================

model Team {
  id          String   @id @default(cuid())
  name        String
  ownerId     String
  plan        String   @default("business") // hérite du plan Business
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User     @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invitations TeamInvitation[]

  @@index([ownerId])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  role      String   @default("member") // owner | admin | member
  joinedAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientAssignments ClientAssignment[]

  @@unique([teamId, userId])
  @@index([userId])
}

// ============================================================
// CLIENT ASSIGNMENTS (Teams — permissions granulaires par client)
// ============================================================
model ClientAssignment {
  id            String   @id @default(cuid())
  clientId      String
  teamMemberId  String
  permission    String   @default("view") // view | edit | manage
  assignedById  String
  createdAt     DateTime @default(now())

  client        Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  teamMember    TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  assignedBy    User       @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: Cascade)

  @@unique([clientId, teamMemberId])
  @@index([clientId])
  @@index([teamMemberId])
}

// ============================================================
// REVENUE ATTRIBUTION (P4 — revenu par client/prospect)
// ============================================================
model RevenueAttribution {
  id            String   @id @default(cuid())
  userId        String
  clientId      String?
  prospectId    String?
  amountCents   Int      // montant en centimes (ex: 9999 = 99,99 €)
  currency      String   @default("EUR")
  source        String   @default("manual") // manual | stripe | import
  description   String?
  attributedAt  DateTime @default(now())
  createdAt     DateTime @default(now())

  user          User       @relation("UserRevenue", fields: [userId], references: [id], onDelete: Cascade)
  client        Client?    @relation("ClientRevenue", fields: [clientId], references: [id], onDelete: SetNull)
  prospect      Prospect?  @relation("ProspectRevenue", fields: [prospectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([prospectId])
  @@index([attributedAt])
}

// ============================================================
// AI AGENT WORKSPACE (P4 — tasks + long-term memory)
// ============================================================
model AgentTask {
  id          String    @id @default(cuid())
  userId      String
  title       String
  description String?
  type        String    @default("custom") // custom | generate_post | analyze_profile | reach_out | follow_up
  status      String    @default("todo") // todo | in_progress | done | blocked
  priority    String    @default("medium") // low | medium | high
  input       String?   // JSON string with task parameters
  output      String?   // JSON string with task result
  agentNotes  String?
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation("UserAgentTasks", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([dueAt])
}

model AgentMemory {
  id        String   @id @default(cuid())
  userId    String
  key       String
  value     String
  category  String   @default("general") // general | preference | fact | goal
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation("UserAgentMemory", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

// ============================================================
// AUDIT LOG (P5+ — traçabilité des actions admin)
// ============================================================
model AuditLog {
  id          String   @id @default(cuid())
  actorId     String
  actorEmail  String
  action      String   // user.ban | user.unban | user.delete | user.changePlan | config.update | ...
  targetType  String?  // User | Client | PostProposal | ...
  targetId    String?
  details     String?  // JSON string with action-specific data
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor       User     @relation("UserAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([targetType, targetId])
}

model TeamInvitation {
  id          String    @id @default(cuid())
  teamId      String
  email       String
  token       String    @unique // token d'invitation signé
  role        String    @default("member") // admin | member
  status      String    @default("pending") // pending | accepted | declined | revoked
  invitedById String
  invitedUserId String? // set si user existe déjà
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedUser User?     @relation("InvitedUser", fields: [invitedUserId], references: [id])

  @@index([teamId])
  @@index([email])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

// ============================================================
// LINKEDIN INTEGRATION
// ============================================================

model LinkedInAccount {
  id             String   @id @default(cuid())
  userId         String
  organizationId String   // urn:li:person:xxx ou urn:li:organization:xxx
  displayName    String
  email          String?
  pictureUrl     String?
  headline       String?
  accessToken    String
  refreshToken   String?
  tokenExpiresAt DateTime?
  scopes         String?
  status         String   @default("active") // active | disabled | expired | revoked
  lastSyncAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // ⚠️ Contrainte @@unique : un seul compte LinkedIn actif par (user, organization)
  // Quand un compte est désactivé, il reste en base -> create() échouerait
  // -> Utiliser upsert() pour réactiver
  @@unique([userId, organizationId])
  @@index([userId])
  @@index([status])
}

// ============================================================
// APP DATA
// ============================================================

model SmartPosterSettings {
  id                String   @id @default(cuid())
  userId            String   @unique
  maxPostsPerDay    Int      @default(3)
  enabled           Boolean  @default(true)
  scheduleHourStart Int      @default(7)
  scheduleHourEnd   Int      @default(8)
  timezone          String   @default("Europe/Paris")
  autoApprove       Boolean  @default(false)
  topics            String   @default("IA, tech, marketing digital, entrepreneurship")
  tone              String   @default("professionnel mais accessible")
  language          String   @default("fr")
  targetAudience    String   @default("entrepreneurs, CTO, managers tech")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PostProposal {
  id             String   @id @default(cuid())
  userId          String?
  clientId        String?  // agency client this post belongs to
  title          String
  content        String
  hashtags       String
  format         String
  angle          String
  targetAudience String
  qualityScore   Float
  optimalTime    String
  status         String   @default("pending") // pending | approved | published | rejected | failed
  engagementEst  String
  linkedinPostId String?
  scheduledFor   DateTime? // planned publication time
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?    @relation("UserPosts", fields: [userId], references: [id], onDelete: SetNull)
  client         Client?  @relation("ClientPosts", fields: [clientId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([scheduledFor])
}

model EngagementMetric {
  id        String   @id @default(cuid())
  userId    String?
  date      String
  likes     Int      @default(0)
  comments  Int      @default(0)
  shares    Int      @default(0)
  views     Int      @default(0)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([date])
}
